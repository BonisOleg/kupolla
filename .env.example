# Скопіюйте в .env і заповніть.
# У цей файл не кладіть реальні ключі, паролі чи вебхуки.

# --- Django ---
# Локально: config.settings.develop (SQLite).
# На сервері: config.settings.production
DJANGO_SETTINGS_MODULE=config.settings.develop

# Обовʼязково унікальний на сервері.
# python3 -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# DEBUG у коді зашитий: develop=True, production=False.

# Локально
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1
# На сервері (HTTPS, без слеша в кінці origin):
# ALLOWED_HOSTS=kupolla.com,www.kupolla.com
# CSRF_TRUSTED_ORIGINS=https://kupolla.com,https://www.kupolla.com

MEDIA_URL=/media/

# --- PostgreSQL (production / Docker) ---
# Локальний develop ці змінні не читає.
# POSTGRES_PASSWORD на сервері обовʼязковий (docker-compose + Django).
POSTGRES_DB=kupolla
POSTGRES_USER=kupolla
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- CRM / аналітика ---
# Make.com / n8n: повний HTTPS URL вебхука. Порожньо = заявки лише в адмінці.
CRM_WEBHOOK_URL=
# GA4: G-XXXXXXXXXX
GA4_MEASUREMENT_ID=

# --- Пошта (production SMTP) ---
# Локальний develop пише листи в консоль.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@kupolla.com
